<!DOCTYPE html>
<html>
<head>
    <title>Ouazzane Landmark: <%= name %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #f0f4f8;
            margin: 0;
            color: #333;
        }
        .container {
            background-color: #ffffff;
            padding: 30px 40px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            width: 80%;
            max-width: 600px;
            /* Keep themed borders */
            border-left-width: 8px;
            border-left-style: solid;
        }
        .historic {
            /* background-color: #f5f5dc; Beige - Correcting previous typo */
            background-color: #fdf8e2;
            border-left-color: #a0522d; /* Sienna */
        }
        .vibrant {
            /* background-color: #e0ffff; LightCyan */
            background-color: #fff0f5; /* LavenderBlush */
            border-left-color: #ff4500; /* OrangeRed */
        }
        .calm {
            /* background-color: #f0fff0; Honeydew */
            background-color: #e6f7ff;
            border-left-color: #4682b4; /* SteelBlue */
        }
        h1 {
            margin-top: 0;
            font-weight: 600;
            color: #222;
        }
        p {
            line-height: 1.6;
        }
        strong {
            font-weight: 600;
        }
        a.back-link {
            display: inline-block;
            margin-top: 20px;
            color: #4a90e2;
            text-decoration: none;
            font-weight: 400;
        }
        a.back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <% 
        let containerClass = theme || 'historic'; // Default to historic
        if (!['historic', 'vibrant', 'calm'].includes(containerClass)) {
            containerClass = 'historic'; // Sanitize if invalid theme
        }
    %>

    <div class="container <%= containerClass %>">
        <h1>Discovering: <%= name %></h1>
        <p>Welcome to <strong><%= name %></strong>, a significant place in Ouazzane!</p>
        <p>Displayed with the <strong><%= containerClass %></strong> theme style.</p>
        
        <a href="/" class="back-link">&larr; Discover another landmark</a>

    </div>

</body>
</html>